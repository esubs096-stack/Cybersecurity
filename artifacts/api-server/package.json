{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "pnpm run db:generate && node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "pnpm run db:generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "cd ../.. && if [ \"$NODE_ENV\" = production ]; then pnpm exec prisma generate --schema prisma/schema.postgres.prisma; else pnpm exec prisma generate --schema prisma/schema.prisma; fi",
    "db:push": "cd ../.. && if [ \"$NODE_ENV\" = production ]; then pnpm exec prisma db push --schema prisma/schema.postgres.prisma; else pnpm exec prisma db push --schema prisma/schema.prisma; fi",
    "seed": "tsx src/demo/seed.ts",
    "demo:reset": "tsx src/demo/reset.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.19.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@zxcvbn-ts/core": "3.0.4",
    "@zxcvbn-ts/language-common": "3.0.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "16.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "nanoid": "5.1.6",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
