# Copy to .env locally, or run `pnpm run gen:keys` to create owner-only local keys.
# Production must use distinct randomly-generated 32-byte base64 values.
MASTER_KEY=replace-with-a-random-32-byte-base64-value
AUDIT_HMAC_KEY=replace-with-a-different-random-32-byte-base64-value
CSRF_SECRET=replace-with-a-third-random-32-byte-base64-value
STORAGE_DIR=./.vaultshare-storage
AUDIT_CHECKPOINT_PATH=./.vaultshare-storage/audit.checkpoint
VAULTSHARE_DATABASE_URL=file:./.vaultshare-storage/vaultshare.sqlite
DEMO_MODE=false
DEMO_PASSWORD=replace-with-a-strong-demo-password
ADMIN_EMAIL=admin@example.invalid
TRUSTED_PROXY_COUNT=1
MAX_UPLOAD_MB=25
